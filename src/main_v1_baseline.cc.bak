#include <assert.h>
#include <errno.h>
#include <fcntl.h>
#include <getopt.h>
#include <pthread.h>
#include <signal.h>
#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/poll.h>
#include <time.h>
#include <unistd.h>
#include <vector>

#include "rtsp_demo.h"
#include "luckfox_mpi.h"
#include "yolov5.h"

#include "opencv2/core/core.hpp"
#include "opencv2/highgui/highgui.hpp"
#include "opencv2/imgproc/imgproc.hpp"

#define DISP_WIDTH  720
#define DISP_HEIGHT 480

// Display size
int width  = DISP_WIDTH;
int height = DISP_HEIGHT;

// Model size
int model_width  = 640;
int model_height = 640;

float scale;
int leftPadding;
int topPadding;


// ============================================================
// Letterbox
// Resize 720x480 image to 640x640 while keeping aspect ratio
// ============================================================
cv::Mat letterbox(cv::Mat input)
{
    float scaleX = (float)model_width / (float)width;
    float scaleY = (float)model_height / (float)height;

    scale = scaleX < scaleY ? scaleX : scaleY;

    int inputWidth  = (int)((float)width * scale);
    int inputHeight = (int)((float)height * scale);

    leftPadding = (model_width - inputWidth) / 2;
    topPadding  = (model_height - inputHeight) / 2;

    cv::Mat inputScale;

    cv::resize(
        input,
        inputScale,
        cv::Size(inputWidth, inputHeight),
        0,
        0,
        cv::INTER_LINEAR
    );

    cv::Mat letterboxImage(
        model_height,
        model_width,
        CV_8UC3,
        cv::Scalar(0, 0, 0)
    );

    cv::Rect roi(
        leftPadding,
        topPadding,
        inputWidth,
        inputHeight
    );

    inputScale.copyTo(letterboxImage(roi));

    return letterboxImage;
}


// ============================================================
// Map 640x640 model coordinates back to 720x480 image
// ============================================================
void mapCoordinates(int *x, int *y)
{
    int mx = *x - leftPadding;
    int my = *y - topPadding;

    *x = (int)((float)mx / scale);
    *y = (int)((float)my / scale);
}


// ============================================================
// Main
// ============================================================
int main(int argc, char *argv[])
{
    system("RkLunch-stop.sh");

    RK_S32 s32Ret = 0;

    int sX, sY, eX, eY;


    // ========================================================
    // RKNN model initialization
    // ========================================================

    // Increased from original 16 bytes to 64 bytes
    char text[64];

    rknn_app_context_t rknn_app_ctx;
    object_detect_result_list od_results;

    const char *model_path = "./model/yolov5.rknn";

    memset(
        &rknn_app_ctx,
        0,
        sizeof(rknn_app_context_t)
    );

    init_yolov5_model(
        model_path,
        &rknn_app_ctx
    );

    printf("init rknn model success!\n");

    init_post_process();


    // ========================================================
    // H264 stream
    // ========================================================

    VENC_STREAM_S stFrame;

    stFrame.pstPack =
        (VENC_PACK_S *)malloc(sizeof(VENC_PACK_S));

    RK_U32 H264_TimeRef = 0;

    VIDEO_FRAME_INFO_S stViFrame;


    // ========================================================
    // Create memory pool
    // ========================================================

    MB_POOL_CONFIG_S PoolCfg;

    memset(
        &PoolCfg,
        0,
        sizeof(MB_POOL_CONFIG_S)
    );

    PoolCfg.u64MBSize =
        width * height * 3;

    PoolCfg.u32MBCnt = 1;

    PoolCfg.enAllocType =
        MB_ALLOC_TYPE_DMA;

    MB_POOL src_Pool =
        RK_MPI_MB_CreatePool(&PoolCfg);

    printf("Create Pool success !\n");


    // ========================================================
    // Get MB from pool
    // ========================================================

    MB_BLK src_Blk =
        RK_MPI_MB_GetMB(
            src_Pool,
            width * height * 3,
            RK_TRUE
        );


    // ========================================================
    // Build H264 input frame
    // ========================================================

    VIDEO_FRAME_INFO_S h264_frame;

    memset(
        &h264_frame,
        0,
        sizeof(VIDEO_FRAME_INFO_S)
    );

    h264_frame.stVFrame.u32Width =
        width;

    h264_frame.stVFrame.u32Height =
        height;

    h264_frame.stVFrame.u32VirWidth =
        width;

    h264_frame.stVFrame.u32VirHeight =
        height;

    h264_frame.stVFrame.enPixelFormat =
        RK_FMT_RGB888;

    h264_frame.stVFrame.u32FrameFlag =
        160;

    h264_frame.stVFrame.pMbBlk =
        src_Blk;


    unsigned char *data =
        (unsigned char *)
        RK_MPI_MB_Handle2VirAddr(src_Blk);


    cv::Mat frame(
        cv::Size(width, height),
        CV_8UC3,
        data
    );


    // ========================================================
    // RKAIQ / ISP initialization
    // ========================================================

    RK_BOOL multi_sensor =
        RK_FALSE;

    const char *iq_dir =
        "/etc/iqfiles";

    rk_aiq_working_mode_t hdr_mode =
        RK_AIQ_WORKING_MODE_NORMAL;

    SAMPLE_COMM_ISP_Init(
        0,
        hdr_mode,
        multi_sensor,
        iq_dir
    );

    SAMPLE_COMM_ISP_Run(0);


    // ========================================================
    // RKMPI initialization
    // ========================================================

    if(RK_MPI_SYS_Init() != RK_SUCCESS)
    {
        RK_LOGE(
            "rk mpi sys init fail!"
        );

        return -1;
    }


    // ========================================================
    // RTSP initialization
    // ========================================================

    rtsp_demo_handle g_rtsplive =
        NULL;

    rtsp_session_handle g_rtsp_session;


    g_rtsplive =
        create_rtsp_demo(554);


    g_rtsp_session =
        rtsp_new_session(
            g_rtsplive,
            "/live/0"
        );


    rtsp_set_video(
        g_rtsp_session,
        RTSP_CODEC_ID_VIDEO_H264,
        NULL,
        0
    );


    rtsp_sync_video_ts(
        g_rtsp_session,
        rtsp_get_reltime(),
        rtsp_get_ntptime()
    );


    // ========================================================
    // VI initialization
    // ========================================================

    vi_dev_init();

    vi_chn_init(
        0,
        width,
        height
    );


    // ========================================================
    // VENC initialization
    // ========================================================

    RK_CODEC_ID_E enCodecType =
        RK_VIDEO_ID_AVC;

    venc_init(
        0,
        width,
        height,
        enCodecType
    );

    printf("venc init success\n");


    // ========================================================
    // Performance statistics
    // ========================================================

    unsigned long frame_count = 0;

    RK_U64 fps_start_time =
        TEST_COMM_GetNowUs();

    float current_fps = 0.0f;


    printf("\n");
    printf("========================================\n");
    printf(" YOLOv5 Performance Monitor Started\n");
    printf(" FPS will also be displayed on RTSP\n");
    printf("========================================\n\n");


    // ========================================================
    // Main loop
    // ========================================================

    while(1)
    {
        // ----------------------------------------------------
        // Start total frame timer
        // ----------------------------------------------------

        RK_U64 t_total_start =
            TEST_COMM_GetNowUs();


        RK_U64 t_capture_start = 0;
        RK_U64 t_capture_end   = 0;

        RK_U64 t_pre_start = 0;
        RK_U64 t_pre_end   = 0;

        RK_U64 t_ai_start = 0;
        RK_U64 t_ai_end   = 0;

        RK_U64 t_draw_start = 0;
        RK_U64 t_draw_end   = 0;

        RK_U64 t_encode_start = 0;
        RK_U64 t_encode_end   = 0;


        // ====================================================
        // 1. CAPTURE
        // ====================================================

        h264_frame.stVFrame.u32TimeRef =
            H264_TimeRef++;

        h264_frame.stVFrame.u64PTS =
            TEST_COMM_GetNowUs();


        t_capture_start =
            TEST_COMM_GetNowUs();


        s32Ret =
            RK_MPI_VI_GetChnFrame(
                0,
                0,
                &stViFrame,
                -1
            );


        t_capture_end =
            TEST_COMM_GetNowUs();


        // ====================================================
        // Successful camera frame
        // ====================================================

        if(s32Ret == RK_SUCCESS)
        {
            // =================================================
            // 2. PREPROCESS
            // =================================================

            t_pre_start =
                TEST_COMM_GetNowUs();


            void *vi_data =
                RK_MPI_MB_Handle2VirAddr(
                    stViFrame.stVFrame.pMbBlk
                );


            // Camera output:
            // YUV420SP
            cv::Mat yuv420sp(
                height + height / 2,
                width,
                CV_8UC1,
                vi_data
            );


            // RGB/BGR image buffer
            cv::Mat bgr(
                height,
                width,
                CV_8UC3,
                data
            );


            // YUV420SP -> BGR
            cv::cvtColor(
                yuv420sp,
                bgr,
                cv::COLOR_YUV420sp2BGR
            );


            // Keep original display resolution
            cv::resize(
                bgr,
                frame,
                cv::Size(width, height),
                0,
                0,
                cv::INTER_LINEAR
            );


            // Letterbox:
            // 720x480 -> 640x640
            cv::Mat letterboxImage =
                letterbox(frame);


            // Copy image into RKNN input memory
            memcpy(
                rknn_app_ctx.input_mems[0]->virt_addr,
                letterboxImage.data,
                model_width * model_height * 3
            );


            t_pre_end =
                TEST_COMM_GetNowUs();


            // =================================================
            // 3. AI
            //
            // inference_yolov5_model contains:
            // rknn_run() + post_process()
            // =================================================

            t_ai_start =
                TEST_COMM_GetNowUs();


            inference_yolov5_model(
                &rknn_app_ctx,
                &od_results
            );


            t_ai_end =
                TEST_COMM_GetNowUs();


            // =================================================
            // 4. DRAW DETECTION RESULTS
            // =================================================

            t_draw_start =
                TEST_COMM_GetNowUs();


            for(
                int i = 0;
                i < od_results.count;
                i++
            )
            {
                object_detect_result *det_result =
                    &(od_results.results[i]);


                // Coordinates in 640x640 model image
                sX =
                    (int)det_result->box.left;

                sY =
                    (int)det_result->box.top;

                eX =
                    (int)det_result->box.right;

                eY =
                    (int)det_result->box.bottom;


                // Map coordinates back to 720x480
                mapCoordinates(
                    &sX,
                    &sY
                );

                mapCoordinates(
                    &eX,
                    &eY
                );


                // Console detection information
                printf(
                    "%s @ (%d %d %d %d) %.3f\n",
                    coco_cls_to_name(
                        det_result->cls_id
                    ),
                    sX,
                    sY,
                    eX,
                    eY,
                    det_result->prop
                );


                // Draw bounding box
                cv::rectangle(
                    frame,
                    cv::Point(sX, sY),
                    cv::Point(eX, eY),
                    cv::Scalar(0, 255, 0),
                    3
                );


                // Detection label
                snprintf(
                    text,
                    sizeof(text),
                    "%s %.1f%%",
                    coco_cls_to_name(
                        det_result->cls_id
                    ),
                    det_result->prop * 100.0f
                );


                // Avoid drawing text outside image
                int text_y =
                    sY > 20 ? sY - 8 : sY + 25;


                cv::putText(
                    frame,
                    text,
                    cv::Point(sX, text_y),
                    cv::FONT_HERSHEY_SIMPLEX,
                    1.0,
                    cv::Scalar(0, 255, 0),
                    2
                );
            }


            // =================================================
            // FPS overlay
            //
            // current_fps is calculated from the previous
            // completed 30-frame window.
            // =================================================

            char fps_text[64];


            if(current_fps > 0.0f)
            {
                snprintf(
                    fps_text,
                    sizeof(fps_text),
                    "FPS: %.1f",
                    current_fps
                );
            }
            else
            {
                snprintf(
                    fps_text,
                    sizeof(fps_text),
                    "FPS: --"
                );
            }


            // Black background for FPS display
            cv::rectangle(
                frame,
                cv::Point(10, 8),
                cv::Point(180, 50),
                cv::Scalar(0, 0, 0),
                -1
            );


            // Draw FPS on video
            cv::putText(
                frame,
                fps_text,
                cv::Point(20, 38),
                cv::FONT_HERSHEY_SIMPLEX,
                0.8,
                cv::Scalar(0, 255, 0),
                2
            );


            t_draw_end =
                TEST_COMM_GetNowUs();
        }


        // ====================================================
        // 5. ENCODE + RTSP
        // ====================================================

        t_encode_start =
            TEST_COMM_GetNowUs();


        // Copy processed OpenCV frame into VENC frame buffer
        memcpy(
            data,
            frame.data,
            width * height * 3
        );


        // Send RGB frame into hardware H264 encoder
        RK_MPI_VENC_SendFrame(
            0,
            &h264_frame,
            -1
        );


        // Get H264 stream
        s32Ret =
            RK_MPI_VENC_GetStream(
                0,
                &stFrame,
                -1
            );


        if(s32Ret == RK_SUCCESS)
        {
            if(
                g_rtsplive &&
                g_rtsp_session
            )
            {
                void *pData =
                    RK_MPI_MB_Handle2VirAddr(
                        stFrame.pstPack->pMbBlk
                    );


                // Send H264 stream through RTSP
                rtsp_tx_video(
                    g_rtsp_session,
                    (uint8_t *)pData,
                    stFrame.pstPack->u32Len,
                    stFrame.pstPack->u64PTS
                );


                rtsp_do_event(
                    g_rtsplive
                );
            }
        }


        t_encode_end =
            TEST_COMM_GetNowUs();


        // ====================================================
        // Release VI frame
        // ====================================================

        s32Ret =
            RK_MPI_VI_ReleaseChnFrame(
                0,
                0,
                &stViFrame
            );


        if(s32Ret != RK_SUCCESS)
        {
            RK_LOGE(
                "RK_MPI_VI_ReleaseChnFrame fail %x",
                s32Ret
            );
        }


        // ====================================================
        // Release VENC stream
        // ====================================================

        s32Ret =
            RK_MPI_VENC_ReleaseStream(
                0,
                &stFrame
            );


        if(s32Ret != RK_SUCCESS)
        {
            RK_LOGE(
                "RK_MPI_VENC_ReleaseStream fail %x",
                s32Ret
            );
        }


        // ====================================================
        // End total frame timer
        // ====================================================

        RK_U64 t_total_end =
            TEST_COMM_GetNowUs();


        // ====================================================
        // Calculate timing results
        // ====================================================

        double capture_ms =
            (t_capture_end - t_capture_start)
            / 1000.0;


        double preprocess_ms = 0.0;

        if(t_pre_end >= t_pre_start &&
           t_pre_start != 0)
        {
            preprocess_ms =
                (t_pre_end - t_pre_start)
                / 1000.0;
        }


        double ai_ms = 0.0;

        if(t_ai_end >= t_ai_start &&
           t_ai_start != 0)
        {
            ai_ms =
                (t_ai_end - t_ai_start)
                / 1000.0;
        }


        double draw_ms = 0.0;

        if(t_draw_end >= t_draw_start &&
           t_draw_start != 0)
        {
            draw_ms =
                (t_draw_end - t_draw_start)
                / 1000.0;
        }


        double encode_ms =
            (t_encode_end - t_encode_start)
            / 1000.0;


        double total_ms =
            (t_total_end - t_total_start)
            / 1000.0;


        // ====================================================
        // FPS calculation
        // ====================================================

        frame_count++;


        if(frame_count % 30 == 0)
        {
            RK_U64 fps_now =
                TEST_COMM_GetNowUs();


            double elapsed_sec =
                (fps_now - fps_start_time)
                / 1000000.0;


            if(elapsed_sec > 0.0)
            {
                current_fps =
                    (float)(30.0 / elapsed_sec);
            }


            fps_start_time =
                fps_now;


            // ================================================
            // Terminal performance output
            // ================================================

            printf("\n");
            printf("========== PERFORMANCE ==========\n");

            printf(
                "Frame        : %lu\n",
                frame_count
            );

            printf(
                "Capture      : %.2f ms\n",
                capture_ms
            );

            printf(
                "Preprocess   : %.2f ms\n",
                preprocess_ms
            );

            printf(
                "AI           : %.2f ms\n",
                ai_ms
            );

            printf(
                "Draw         : %.2f ms\n",
                draw_ms
            );

            printf(
                "Encode+RTSP  : %.2f ms\n",
                encode_ms
            );

            printf(
                "Total        : %.2f ms\n",
                total_ms
            );

            printf(
                "FPS          : %.2f\n",
                current_fps
            );

            printf("=================================\n\n");
        }


        memset(
            text,
            0,
            sizeof(text)
        );
    }


    // ========================================================
    // Cleanup
    // ========================================================

    RK_MPI_MB_ReleaseMB(
        src_Blk
    );


    RK_MPI_MB_DestroyPool(
        src_Pool
    );


    RK_MPI_VI_DisableChn(
        0,
        0
    );


    RK_MPI_VI_DisableDev(
        0
    );


    SAMPLE_COMM_ISP_Stop(
        0
    );


    RK_MPI_VENC_StopRecvFrame(
        0
    );


    RK_MPI_VENC_DestroyChn(
        0
    );


    free(
        stFrame.pstPack
    );


    if(g_rtsplive)
    {
        rtsp_del_demo(
            g_rtsplive
        );
    }


    RK_MPI_SYS_Exit();


    // Release RKNN model
    release_yolov5_model(
        &rknn_app_ctx
    );


    deinit_post_process();


    return 0;
}
